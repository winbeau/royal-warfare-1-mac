class_name FlashClipData
extends Resource
## Static description of one exported Flash timeline (generated by pipeline/clips.py).
## Frame numbers are 1-based like AS3; per-frame arrays are indexed with frame - 1.

@export var character_id := 0
@export var total_frames := 1
## Local bounds of everything the clip can show, in 1x pixels.
@export var rect := Rect2()
## Unique 2x textures of the unnamed content below / above the named children.
@export var back_textures: Array = []
@export var back_offsets := PackedVector2Array()   # 1x offset of each texture
@export var back_index := PackedInt32Array()       # per frame; -1 = nothing
@export var front_textures: Array = []
@export var front_offsets := PackedVector2Array()
@export var front_index := PackedInt32Array()
## Pure animations reuse the shared 1x atlas in assets/library/sprites/<id>/frames.tres.
@export var reuse_frames: SpriteFrames
@export var reuse_offset := Vector2.ZERO
## frame -> Array of ops: ["stop"], ["done"], ["goto_play", n]
@export var scripts: Dictionary = {}
## name -> {frames: PackedInt32Array, states: PackedFloat32Array (stride 11), kind, depth}
## state = [visible, a, b, c, d, tx, ty, rMul, gMul, bMul, aMul]
@export var children: Dictionary = {}
const STATE_STRIDE := 11

var _hit_images := {}

func hit_image(tex: Texture2D) -> Image:
	if not _hit_images.has(tex):
		_hit_images[tex] = tex.get_image()
	return _hit_images[tex]
